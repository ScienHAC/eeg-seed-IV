    },
    {
      "name": "Alpha",
      "symbol": "α", 
      "range": "8-14 Hz",
      "significance": "Relaxed awareness, eyes closed",
      "color": "#10b981"
    },
    {
      "name": "Beta",
      "symbol": "β",
      "range": "14-31 Hz", 
