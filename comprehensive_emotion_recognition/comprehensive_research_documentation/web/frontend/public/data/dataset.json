      "arousal": "High",
      "valence": "Negative", 
      "clipsPerSession": 6,
      "color": "#ef4444"
    },
    {
      "label": 3,
      "name": "Happy",
      "description": "Joy, happiness, excitement",
      "arousal": "High",
      "valence": "Positive",
      "clipsPerSession": 6,
      "color": "#22c55e"
