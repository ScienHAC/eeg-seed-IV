  "description": "EEG-based Emotion Recognition Dataset from Shanghai Jiao Tong University BCMI Lab",
  "origin": "Shanghai Jiao Tong University",
  "publication": "Investigating Critical Frequency Bands and Channels for EEG-based Emotion Recognition",
  "totalSubjects": 15,
  "genderDistribution": {
    "male": 7,
    "female": 8
